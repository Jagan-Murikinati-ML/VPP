| where sourceTimestamp >= startofday(ago(1d))
| where sourceTimestamp < startofday(now())
| summarize 
    RowCount = count(),
    MinTime = min(sourceTimestamp),
    MaxTime = max(sourceTimestamp),
    UniqueSites = dcount(siteId),
    UniqueOEMs = dcount(oem)
*/

