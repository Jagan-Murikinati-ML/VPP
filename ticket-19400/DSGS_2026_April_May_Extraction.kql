// ============================================================================
// TICKET 19400: DSGS 2026 - April & May Battery Interval Data Extraction
// Using proven method from Ticket 13204 (Juan's LEAP script)
// 
// Task: Extract 15-minute battery interval data for 8,188 DSGS enrolled sites
// Date Range: April 1, 2026 - May 31, 2026 (61 days)
// Output Format: LEAP template (matches Shuai's requirements)
//
// CRITICAL CONSTRAINT MAINTAINED:
// Bad data filter: Remove records where:
//   battery_200_IncWhExp >= 7500 or battery_200_IncWhExp < 0 
//   or battery_200_IncWhImp >= 7500 or battery_200_IncWhImp < 0
// ============================================================================

let testsite = dynamic([]);

// DSGS 2026 Enrolled Site List from Shuai (leap_meters_export_05282026.csv)
// Total: 8,188 enrolled sites
// Sources: 7,990 (400-series), 196 (100-series), 2 (other)
let dsgs_site_list = dynamic([
    "400040232", "400040229", "400037443", "400037435", "400037433", "400037430", "400037425", "400037393", "400037391", "400037389",
    "400037388", "400037385", "400037373", "400037372", "400037369", "400037351", "400037344", "400037342", "400037340", "400037339",
    "400037337", "400037331", "400037325", "400037318", "400037315", "400037313", "400037308", "400037293", "400037289", "400037277",
    "400037274", "400037265", "400037260", "400037258", "400037256", "400037253", "400037250", "400037249", "400037241", "400037237",
    "400037232", "400037231", "400037224", "400037218", "400037216", "400037215", "400037207", "400037200", "400037198", "400037195",
    "400037188", "400037179", "400037178", "400037176", "400037161", "400037159", "400037155", "400037148", "400037147", "400037104",
    "400037032", "400037026", "400037021", "400037020", "400037014", "400037010", "400037006", "400037004", "400037002", "400036999",
    "400036994", "400036992", "400036991", "400036990", "400036989", "400036987", "400036983", "400036980", "400036973", "400036972",
    "400036969", "400036964", "400036958", "400036956", "400036951", "400036947", "400036942", "400036934", "400036933", "400036926",
    "400036922", "400036921", "400036910", "400036899", "400036888", "400036887", "400036886", "400036884", "400036883", "400036882",
    "400036879", "400036868", "400036855", "400036852", "400036808", "400036805", "400036800", "400036789", "400036785", "400036784",
    "100003023"
    // NOTE: Full list truncated for display
    // Complete 8,188 sites in: ticket-19400/enrolled_sites_kql_array.txt
]);

// ============================================================================
// DATE RANGE CONFIGURATION
// ============================================================================
let startTime = datetime(4/1/2026 00:00:00);
let endTime   = datetime(6/1/2026 00:00:00);  // 6/1 to include all of 5/31
// Total: 61 days × 96 intervals/day = 5,856 intervals per site

// ============================================================================
// STEP 1: IDENTIFY BAD DATA TO REMOVE
// ============================================================================
// Identifies records with invalid battery values (outside 0-7500 Wh range)
// These records will be EXCLUDED via leftanti join in STEP 4
//
// CRITICAL: This maintains the same bad data filter as Ticket 13204

let recordsToRemove = 
    silverCommDataSite
    | where 1==1
        // Extended date range to catch bad data from before/after extraction window
        and sourceTimestamp between (datetime(3/25/2026 00:00:00) .. datetime(6/15/2026 00:00:00))
        // CRITICAL FILTER: Battery energy values must be in range [0, 7500) Wh per 15-min interval
        and (battery_200_IncWhExp >= 7500 
          or battery_200_IncWhExp < 0 
          or battery_200_IncWhImp >= 7500 
          or battery_200_IncWhImp < 0)
    | project siteId, sourceTimestamp, battery_200_IncWhExp, battery_200_IncWhImp
;

// ============================================================================
// STEP 2: CREATE TIME BACKBONE (15-MINUTE INTERVALS)
// ============================================================================
// Foundation: all 15-minute intervals between startTime and endTime
// Result: 5,856 time bins per site for 61-day period

let allBins = range bin_base from startTime to endTime step 15m;

// ============================================================================
// STEP 3: FETCH METER IDS FROM ASSET REGISTRY
// ============================================================================
// Get meterId from Asset Registry and filter to Shuai's enrolled site list
//
// NOTE: If Asset Registry doesn't have all 8,188 sites, only those with 
//       Leap Contracts will return. Missing sites = no telemetry output.
//       This was validated in Ticket 19400 PHASE 1 (validation query).

let meterId =
    goldAdtPropertyMinMaxLatestViewV2
    | where Key == 'meterId'
      and ModelId startswith 'dtmi:qcells:contract:leapContract'
      and tolower(actionMax) != 'delete'
    | join kind=inner (
        goldAdtAllRelationshipsLatestView
        | where tolower(Action) != 'delete'
        | project siteId = Source, Target
    ) on $left.Id == $right.Target
    | distinct meterId = valueMax, siteId
    // KEY CHANGE FROM TICKET 13204: Filter to only sites in Shuai's Excel list
    | where siteId in (dsgs_site_list)
    | where 1==1
        and (siteId in (testsite) or array_length(testsite) == 0)
    | project meterId, siteId
;

// ============================================================================
// STEP 4: GET TELEMETRY DATA FOR SITES
// ============================================================================
// Fetch battery telemetry from silverCommDataSite
// Apply CRITICAL bad data removal using leftanti join
// Normalize timestamps to 15-minute boundaries
//
// LEFTANTI JOIN LOGIC:
// Keeps records where (siteId, sourceTimestamp) are NOT in recordsToRemove
// Result: All remaining records have valid battery values in [0, 7500) Wh range

let sites = silverCommDataSite
    | where siteId in (meterId | project siteId)
    | where sourceTimestamp between (datetime_add('minute',-30,startTime) .. datetime_add('minute',45,endTime))
    // CRITICAL STEP: Remove bad records using leftanti join
    | join kind=leftanti (recordsToRemove) on siteId, sourceTimestamp
    // At this point: ALL remaining records have clean battery data
    | extend normalizedTimestamp = bin(sourceTimestamp, 15m)
    | extend local_normalizedts = bin((sourceTimestamp - 7h), 15m)  // Pacific Time (UTC-7)
    | extend local_sourceTimestamp = sourceTimestamp - 7h
    | join kind=inner (meterId) on siteId
    | project siteId, meterId, oem, sourceTimestamp, normalizedTimestamp, 
              local_normalizedts, local_sourceTimestamp, battery_200_IncWhImp, battery_200_IncWhExp
    | order by siteId, sourceTimestamp
;

// ============================================================================
// STEP 5: CREATE OEM LIST (FOR SOLAREDGE TIME ADJUSTMENT)
// ============================================================================
// SolarEdge inverters require 15-minute time shift
// (See Ticket 13204 analysis - Juan's notes on SolarEdge specifics)

let oems = materialize(
    sites | distinct siteId, oem
);

// ============================================================================
// STEP 6: JOIN SITE LIST × TIME BACKBONE × TELEMETRY DATA
// ============================================================================
// Creates complete grid: every site × every 15-minute interval
// Missing telemetry data appears as NULL
//
// Result: 8,188 sites × 5,856 intervals = ~48 million rows total

let new_bin_base_join = 
    meterId
    | extend dummy = 1
    | join kind = fullouter (allBins | extend dummy = 1) on dummy
    | project-away dummy, dummy1
    | join kind = leftouter (sites) on $left.bin_base == $right.normalizedTimestamp and siteId and meterId
    | project-away siteId1, meterId1
    | order by siteId, meterId, bin_base asc
    | serialize
    | extend energy_consumed_kwh = battery_200_IncWhImp/1000     // Convert Wh → kWh
        ,energy_generated_kwh = battery_200_IncWhExp/1000
    | extend energy_net_kwh = energy_consumed_kwh - energy_generated_kwh
    | extend local_bin = bin_base - 7h
    | project meter_id = meterId, 
              siteId, oem, 
              sourceTimestamp,
              local_interval_start_time = coalesce(local_normalizedts, local_bin),
              local_interval_end_time = coalesce(local_normalizedts + 15m, local_bin + 15m),
              bin_base,
              interval_start_time_utc = bin_base,
              interval_end_time_utc = bin_base + 15m,
              battery_200_IncWhImp,
              battery_200_IncWhExp,
              energy_net_kwh,
              energy_consumed_kwh, 
              energy_generated_kwh, 
              final = 'true', 
              region = 'CA'
    // SolarEdge adjustment: shift interval by 15 minutes
    | extend interval_start_time_utc = iif(siteId in (oems | where oem == 'solaredge' | project siteId), interval_start_time_utc - 15m, interval_start_time_utc)
        ,interval_end_time_utc = iif(siteId in (oems | where oem == 'solaredge' | project siteId), interval_end_time_utc - 15m, interval_end_time_utc)
;

// ============================================================================
// STEP 7: AGGREGATE AND FORMAT OUTPUT (LEAP TEMPLATE)
// ============================================================================
// Final aggregation and formatting to match Shuai's LEAP template
//
// Output format:
// meter_id, interval_start_time_utc, interval_end_time_utc,
// energy_net_kwh, energy_consumed_kwh, energy_generated_kwh, final, region

new_bin_base_join
| summarize 
    energy_net_kwh = sum(energy_net_kwh), 
    energy_consumed_kwh = sum(energy_consumed_kwh), 
    energy_generated_kwh = sum(energy_generated_kwh),
    // Handle nulls: if all values for interval are null, output "Null"; otherwise sum
    energy_net_kwh_nulls = iif(countif(isnotnull(energy_net_kwh)) == 0, real(null), sum(energy_net_kwh)),
    energy_consumed_kwh_nulls = iif(countif(isnotnull(energy_consumed_kwh)) == 0, real(null), sum(energy_consumed_kwh)),
    energy_generated_kwh_nulls = iif(countif(isnotnull(energy_generated_kwh)) == 0, real(null), sum(energy_generated_kwh))
    by meter_id, interval_start_time_utc, interval_end_time_utc, final, region
| project meter_id, 
        interval_start_time_utc = strcat(format_datetime(interval_start_time_utc, "yyyy-MM-dd"), "T", format_datetime(interval_start_time_utc, "HH:mm:ss.ffff"), "Z"),
        interval_end_time_utc = strcat(format_datetime(interval_end_time_utc, "yyyy-MM-dd"), "T", format_datetime(interval_end_time_utc, "HH:mm:ss.ffff"), "Z"),
        energy_net_kwh = coalesce(tostring(round(energy_net_kwh_nulls,3)), "Null"),
        energy_consumed_kwh = coalesce(tostring(round(energy_consumed_kwh_nulls,3)), "Null"),
        energy_generated_kwh = coalesce(tostring(round(energy_generated_kwh_nulls,3)), "Null"),
        final = 'true',
        region = 'CA'
| order by interval_start_time_utc asc, meter_id asc
// Filter out invalid timestamps
| where interval_start_time_utc != 'TZ' 
    and interval_start_time_utc != strcat(format_datetime(endTime, "yyyy-MM-dd"), "T", format_datetime(endTime, "HH:mm:ss.ffff"), "Z")
    and interval_end_time_utc != strcat(format_datetime(startTime, "yyyy-MM-dd"), "T", format_datetime(startTime, "HH:mm:ss.ffff"), "Z")

// ============================================================================
// EXECUTION NOTES
// ============================================================================
// 
// BEFORE RUNNING:
// 1. Replace truncated dsgs_site_list with full 8,188 sites from:
//    ticket-19400/enrolled_sites_kql_array.txt
// 
// 2. Verify Asset Registry ModelId (line 65):
//    - If DSGS uses different contract type, ask team to confirm
//    - Currently set to: 'dtmi:qcells:contract:leapContract'
// 
// 3. Optional: Test with first 100 sites before full run
//    let testsite = dynamic(["400040232", "400040229", ... first 100 ...]);
// 
// EXPECTED RESULTS:
// - Total rows: ~48 million (8,188 sites × 5,856 intervals)
// - Runtime: 10-15 minutes (full extraction)
// - File size: 1-2 GB (CSV export)
// - Output columns: 8 (meter_id, timestamps, energy values, final, region)
// 
// CONSTRAINTS MAINTAINED:
// ✅ Bad data filter (0-7500 Wh) applied throughout pipeline
// ✅ Leftanti join removes all invalid records
// ✅ 15-minute intervals (5,856 per site for 61 days)
// ✅ UTC timestamps in ISO 8601 format
// ✅ Energy values in kWh (rounded to 3 decimals)
// ✅ NULL values for missing telemetry data
// ✅ SolarEdge time adjustment applied
// ✅ LEAP template format (matches Shuai's requirements)
// ============================================================================
