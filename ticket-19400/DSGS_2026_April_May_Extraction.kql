// ============================================================================
// TICKET 19400: DSGS April & May 2026 Battery Interval Data Extraction
// ============================================================================
// Purpose: Extract 15-minute battery interval data for 8,188 validated DSGS sites
// Date: 2026-05-30
// Author: Jagan Murikinati
// Based on: Ticket 13204 approach (approved by Shuai & Kai)
//
// Validation: All 8,188 sites validated against Asset Registry (Leap Contracts)
// Target Format: Leap's interval_data_load_template.csv
// Time Period: April 1 - May 31, 2026 (2 months)
// ============================================================================

// ============================================================================
// CONFIGURATION SECTION
// ============================================================================

// Test specific sites (empty = process all sites)
let testsite = dynamic([]);

// IMPORTANT: This site list comes from the VALIDATED sites in DSGS_LeapContract_Validation_READY.kql
// After validation is complete and AR team confirms all sites have Leap Contracts,
// paste the full 8,188 site list here
// Format: 10 site IDs per line (same as ticket-13204)

let dsgs_site_list_2026 = dynamic([
    // PLACEHOLDER: Replace with actual 8,188 site IDs from leap_meters_export_05282026.csv
    // Auto-generated from: leap_meters_export_05282026.csv (8,188 sites)
    // Use parse_enrolled_sites.py to generate this array
    
    // Example format (first 20 sites shown):
    "100002495", "100002784", "100002814", "100003023", "100003075", "100003077", "100003087", "100003173", "100003232", "100003257",
    "100003271", "100003302", "100003386", "100003417", "100003421", "100003434", "100003487", "100003500", "100003532", "100003535"
    
    // TODO: PASTE FULL 8,188 SITE LIST HERE (from generate_site_array.py output)
]);

// Date range for extraction: April & May 2026 (2 full months)
let startTime = datetime(4/1/2026 00:00:00);
let endTime   = datetime(6/1/2026 00:00:00);  // June 1 to include all of May 31

// ============================================================================
// STEP 1: IDENTIFY BAD DATA TO REMOVE
// ============================================================================
// Filter out telemetry records with invalid battery values:
// - Exported >= 7500 Wh (unrealistic for 15-min interval)
// - Imported >= 7500 Wh (unrealistic for 15-min interval)  
// - Negative values (data quality issue)

let recordsToRemove = 
    silverCommDataSite
    | where 1==1
        and sourceTimestamp between (datetime(3/25/2026 00:00:00) .. datetime(6/7/2026 00:00:00))  // Buffer around target range
        and (battery_200_IncWhExp >= 7500 
          or battery_200_IncWhExp < 0 
          or battery_200_IncWhImp >= 7500 
          or battery_200_IncWhImp < 0)
    | project siteId, sourceTimestamp, battery_200_IncWhExp, battery_200_IncWhImp
;

// ============================================================================
// STEP 2: CREATE TIME BACKBONE (15-MINUTE INTERVALS)
// ============================================================================
// April: 30 days × 96 intervals/day = 2,880 intervals
// May:   31 days × 96 intervals/day = 2,976 intervals
// Total: 61 days × 96 intervals/day = 5,856 intervals

let allBins = range bin_base from startTime to endTime step 15m;

// ============================================================================
// STEP 3: FETCH METER IDS FROM ASSET REGISTRY
// ============================================================================
// Fetch meterId from Asset Registry Leap Contracts
// Filter to only validated DSGS sites from our site list

let meterId =
    goldAdtPropertyMinMaxLatestViewV2
    | where Key == 'meterId'
      and ModelId startswith 'dtmi:qcells:contract:leapContract'  // Leap Contract (validated in Ticket 19400)
      and tolower(actionMax) != 'delete'
    | join kind=inner (
        goldAdtAllRelationshipsLatestView
        | where tolower(Action) != 'delete'
        | project siteId = Source, Target
    ) on $left.Id == $right.Target
    | distinct meterId = valueMax, siteId
    // KEY FILTER: Only sites from validated list (8,188 sites)
    | where siteId in (dsgs_site_list_2026)
    | where 1==1
        and (siteId in (testsite) or array_length(testsite) == 0)
    | project meterId, siteId
;

// DIAGNOSTIC: Check meterId count
// Expected: ~8,188 (all sites should have meterId after AR validation)
// If significantly less, some sites may be missing Leap Contracts in AR
// meterId | count;

// ============================================================================
// STEP 4: GET TELEMETRY DATA FOR SITES
// ============================================================================
// Query telemetry for battery data:
// - battery_200_IncWhImp: Energy imported TO battery (charging)
// - battery_200_IncWhExp: Energy exported FROM battery (discharging)

let sites = silverCommDataSite
    | where siteId in (meterId | project siteId)
    | where sourceTimestamp between (startTime .. endTime)
    | join kind=leftanti (recordsToRemove) on siteId, sourceTimestamp  // Exclude bad data
    | extend normalizedTimestamp = bin(sourceTimestamp, 15m)
    | extend local_normalizedts = bin((sourceTimestamp - 7h), 15m)  // Pacific Time (UTC-7)
    | join kind=inner (meterId) on siteId  // Add meterId
    | project siteId, meterId, oem, sourceTimestamp, normalizedTimestamp,
              local_normalizedts, battery_200_IncWhImp, battery_200_IncWhExp
;

// ============================================================================
// STEP 5: CREATE OEM LIST (FOR SOLAREDGE ADJUSTMENT)
// ============================================================================
// SolarEdge sites require 15-minute timestamp adjustment (known data reporting offset)

let oems = materialize(
    sites | distinct siteId, oem
);

// ============================================================================
// STEP 6: JOIN SITE LIST × TIME BACKBONE × TELEMETRY DATA
// ============================================================================
// Create Cartesian product: All sites × All time intervals
// Then left join actual telemetry data
// Result: Complete matrix with NULL for missing telemetry

let new_bin_base_join =
    meterId
    | extend dummy = 1
    | join kind = fullouter (allBins | extend dummy = 1) on dummy
    | project-away dummy, dummy1
    | join kind = leftouter (sites) on $left.bin_base == $right.normalizedTimestamp and siteId and meterId
    | project-away siteId1, meterId1
    | order by siteId, meterId, bin_base asc
    | serialize
