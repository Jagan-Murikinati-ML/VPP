.create-or-alter function getAllVppSitesList(
    inputUserId: string = "",
    page_index: int = 0,
    page_size: int = 50,
    sorting: dynamic = dynamic([]),
    filters: dynamic = dynamic([]),
    searchText: string = ""
){
    let site_ids_from_user = 
        goldAdtTwinEventsLatestV2
        | where TwinId in (
            goldResourceGroupToSiteMapping 
            | where resource_group_id in (
                goldUserGroupToResourceGroupMapping 
                | where user_group_id in (
                    goldUserGroupToUserMapping 
                    | where user_ids == inputUserId and isingroup > 0
                    | project user_group_id
                ) and isingroup > 0 
                | project resource_group_ids
            ) and isingroup > 0
            | project site_ids
        ) and Action != 'Delete'
        | extend siteId = TwinId
        | summarize make_set(TwinId)
        | project list_site_ids = set_TwinId
    ;
    // ============================================================================
    // PHASE 2: VPP SITES FILTER - Only VPP registered sites
    // ============================================================================
    let vppSites = materialize(
        goldAdtPropertyMinMaxLatestViewV2 
        | where Id in (site_ids_from_user)
        | where Key == 'isVppRegistered' and tolower(valueMax) == 'true'
        | join kind=inner (goldAdtTwinEventsLatestV2 | where Action != 'Delete') 
            on $left.Id == $right.TwinId
    );
    let allSiteIdsList = toscalar(vppSites | summarize make_list(Id));
    // ============================================================================
    // PHASE 3: SITE PROPERTIES - Minimal fields for filtering/sorting
    // ============================================================================
    let goldAdtPropertySites_minimal = 
        materialize(
            goldAdtPropertyMinMaxLatestViewV2
            | where Id in (allSiteIdsList)
                and actionMax != 'Delete'
                and (Key startswith "oemInfo" and Key endswith "oemName"
                    or Key in (dynamic([
                        'address.stateProvince',
                        'address.zipPostalCode',
                        'siteName',
                        'assetRegistrationInfo.accountNumber'
                    ])))
            | summarize
                state = take_anyif(valueMax, Key == 'address.stateProvince'),
                zipCode = take_anyif(valueMax, Key == 'address.zipPostalCode'),
                siteName = take_anyif(valueMax, Key == 'siteName'),
                accountNumber = take_anyif(valueMax, Key == 'assetRegistrationInfo.accountNumber'),
                (_, oem) = arg_max(
                    iif(Key == 'oemInfo.oemName', -1,
                        iif(Key startswith "oemInfo" and Key endswith "oemName", 
                            toint(extract(@'oemInfo\.(\d+)\.oemName', 1, Key)), 
                            int(null)))
                    , valueMax)
            by siteId = Id
        )
    ;
    // ============================================================================
    // PHASE 4: PROGRAM DATA - Get program enrollments
    // ============================================================================
    let program_data = GetLatestProgramSiteInfo
        | where site_id in (allSiteIdsList)
        | join kind=inner (
            GetLatestProgramInfo 
            | project program_id, program_name, program_type
        ) on program_id
        | summarize program_name = make_set(program_name) by site_id
    ;
    // ============================================================================
    // PHASE 4b: COMMUNICATION STATUS - Latest sourceTimestamp per site
    // ============================================================================
    let comm_status_data = materialize(
        silverCommDataSite
        | where siteId in (allSiteIdsList)
        | summarize lastTimestamp = max(sourceTimestamp) by siteId
        | project siteId, communication_status = lastTimestamp > now() - 1h
    );
    // ============================================================================
    // PHASE 5: BUILD DATASET - Combine site properties with programs and comm status
    // ============================================================================
    let all_sites_basic = goldAdtPropertySites_minimal
        | project
            siteId,
            siteName,
            zipPostalCode = zipCode,
            state,
            oemname = oem,
            accountNumber
        | join kind=leftouter (program_data) on $left.siteId == $right.site_id
        | join kind=leftouter (comm_status_data) on siteId
        | project
            siteId,
            siteName,
            zipPostalCode,
            state,
            oemname,
            accountNumber,
            program_name = coalesce(program_name, dynamic([])),
            communication_status = coalesce(communication_status, false)
    ; 
    let total_records_count = toscalar(all_sites_basic | count);
    // ============================================================================
    // PHASE 6: GLOBAL SEARCH - Search across all text fields
    // ============================================================================
    let searched_data = all_sites_basic
        | where isempty(searchText) or (
            siteId contains searchText or
            tostring(siteName) contains searchText or
            tostring(state) contains searchText or
            tostring(zipPostalCode) contains searchText or
            tostring(accountNumber) contains searchText or
            tostring(program_name) contains searchText or
            tostring(oemname) contains searchText
        )
    ;
    // ============================================================================
    // PHASE 7: DYNAMIC FILTERING - Apply user-defined filters
    // ============================================================================
    let has_filters = array_length(filters) > 0;
    let filtered_data = searched_data
        | extend has_filters_flag = has_filters
        | extend filter_count = array_length(filters)
        | extend siteName_str = tostring(siteName)
        | extend program_name_str = tostring(program_name)
        | mv-expand bagexpansion=array filter_index = iff(has_filters, range(0, array_length(filters) - 1, 1), dynamic([0])) to typeof(int)
        | extend filter_field = iff(has_filters, tostring(filters[filter_index].field), "")
        | extend filter_op = iff(has_filters, tolower(tostring(filters[filter_index].op)), "")
        | extend filter_value = iff(has_filters, tostring(filters[filter_index].value), "")
        | extend filter_matches = iff(has_filters, case(
            filter_field == "site_number" and filter_op == "==", tolower(siteId) == tolower(filter_value),
            filter_field == "site_number" and filter_op == "contains", siteId contains tolower(filter_value),
            filter_field == "site_name" and filter_op == "==", tolower(siteName_str) == tolower(filter_value),
            filter_field == "site_name" and filter_op == "contains", siteName_str contains tolower(filter_value),
            filter_field == "state" and filter_op == "==", tolower(state) == tolower(filter_value),
            filter_field == "state" and filter_op == "contains", state contains tolower(filter_value),
            filter_field == "zipPostalCode" and filter_op == "==", tolower(zipPostalCode) == tolower(filter_value),
            filter_field == "zipPostalCode" and filter_op == "contains", zipPostalCode contains tolower(filter_value),
            filter_field == "external_reference_id" and filter_op == "==", tolower(accountNumber) == tolower(filter_value),
            filter_field == "external_reference_id" and filter_op == "contains", accountNumber contains tolower(filter_value),
            filter_field == "program_name" and filter_op == "==", array_index_of(program_name, filter_value) != -1,
            filter_field == "program_name" and filter_op == "contains", program_name_str contains tolower(filter_value),
            filter_field == "oem_name" and filter_op == "==", tolower(oemname) == tolower(filter_value),
            filter_field == "oem_name" and filter_op == "contains", oemname contains tolower(filter_value),
            // NEW: communication_status filter
            filter_field == "communication_status" and filter_op == "==", tostring(communication_status) == tolower(filter_value),
            false
        ), true)
        | summarize matched_filters = countif(filter_matches), total_filters = max(filter_count)
            by siteId, siteName_str, zipPostalCode, state, oemname, accountNumber, program_name_str, has_filters_flag, communication_status
        | where has_filters_flag == false or matched_filters == total_filters
        | extend siteName = siteName_str, program_name = todynamic(program_name_str)
        | project siteId, siteName, zipPostalCode, state, oemname, accountNumber, program_name, communication_status
    ;
    // ============================================================================
    // PHASE 8: DYNAMIC SORTING - Sort by any field
    // ============================================================================
    let sort_field = iff(array_length(sorting) > 0, tostring(sorting[0].field), "site_number");
    let sort_direction = iff(array_length(sorting) > 0, tolower(tostring(sorting[0].direction)), "asc");
    let sorted_data = filtered_data
        | extend sort_key_padded = strcat(repeat("0", 20 - strlen(siteId)), siteId)
        | extend sort_key_asc = case(
            sort_field == "site_number", sort_key_padded,
            sort_field == "site_name", tolower(tostring(siteName)),
            sort_field == "state", tolower(state),
            sort_field == "zipPostalCode", zipPostalCode,
            sort_field == "external_reference_id", tolower(accountNumber),
            sort_field == "program_name", tolower(strcat_array(program_name, ", ")),
            sort_field == "oem_name", tolower(oemname),
            // NEW: communication_status sort (true=online sorts after false=offline in asc)
            sort_field == "communication_status", tostring(communication_status),
            sort_key_padded
        )
        | extend sort_key_desc = sort_key_asc
        | order by sort_key_asc asc, siteId asc
        | extend rank_asc = row_number()
        | order by sort_key_desc desc, siteId desc
        | extend rank_desc = row_number()
        | extend final_rank = case(sort_direction == "desc", rank_desc, rank_asc)
        | order by final_rank asc
        | serialize sort_rank = row_number()
        | project-away sort_key_padded, sort_key_asc, sort_key_desc, rank_asc, rank_desc, final_rank
    ;
    // Total count after filters/search
    let total_count = toscalar(sorted_data | count);
    // ============================================================================
    // PHASE 9: PAGINATION - Get only the requested page
    // ============================================================================
    let paginated_site_data = sorted_data
        | where sort_rank > page_index * page_size and sort_rank <= (page_index + 1) * page_size
    ;
    // ============================================================================
    // PHASE 10: FORMAT RESPONSE - Return site list with metadata
    // ============================================================================
    let result_data = paginated_site_data
        | project
            site_number = siteId,
            site_name = siteName,
            state,
            zipPostalCode,
            external_reference_id = accountNumber,
            program_name,
            oem_name = oemname,
            communication_status,
            sort_rank
        | order by sort_rank asc
    ;
    // ============================================================================
    // FINAL RESPONSE - Structured output with pagination metadata
    // ============================================================================
    let data_value = result_data | project-away sort_rank | summarize data = make_list(pack_all());
    let page_count = toscalar(result_data | summarize count_distinct(site_number));
    let pagination_metadata = pack('pagination', pack(
        'page', page_index,
        'page_size', page_count,
        'total_count', total_count,
        'total_records_count', total_records_count
    ));
    let status = iff(total_count == 0, 404, 200);
    data_value
    | extend metadata = pagination_metadata, status = status
    | project metadata, data, status
}