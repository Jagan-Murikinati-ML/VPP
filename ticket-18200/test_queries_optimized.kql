// ============================================================================
// TEST 1: Performance Test - Last 30 Days
// ============================================================================
print "=== TEST 1: Last 30 Days Performance ===";
let start_time = now();
let result = getVPPEventMetrics_test(
    '',              // Empty = all events in range
    ago(30d),        // Start date
    now()            // End date
);
let end_time = now();
print duration_ms = datetime_diff('millisecond', end_time, start_time);
result;

// Expected: 1-2 seconds ✅

